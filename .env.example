# SQLite база данных Prisma (файл будет создан в prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Секрет для подписывания JWT-сессий (jose, HS256). Сгенерируйте длинную случайную строку.
JWT_SECRET="replace-with-long-random-secret-min-32-chars"

# Базовый URL приложения (для редиректов из Server Actions)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
