# SQLite (файл создаётся командой `npx prisma db push`)
DATABASE_URL="file:./dev.db"

# Секрет для подписания JWT-сессий (jose) — сгенерируйте: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-secret"

# Публичный URL приложения (для редиректов из Server Actions)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
