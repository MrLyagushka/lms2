// prisma/schema.prisma
// Схема базы данных образовательной платформы (учитель ↔ ученик, ДЗ, ответы)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums (SQLite не поддерживает нативные enum в Prisma —
// используем String с константами из src/lib/constants.ts)
// Значения:
//   Role:         TEACHER | STUDENT
//   HomeworkStatus: DRAFT | SUBMITTED | CHECKED
// ─────────────────────────────────────────────

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  role         String // 'TEACHER' | 'STUDENT'
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?

  @@index([email])
}

model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  fullName    String
  subject     String?
  teacherCode String   @unique // 6-символьный код для привязки учеников
  bio         String?
  createdAt   DateTime @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  students  StudentProfile[]
  homeworks Homework[]

  @@index([teacherCode])
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  grade     String? // класс/курс, например "7Б"
  notes     String? // заметки учителя об ученике (редактирует учитель)
  teacherId String? // nullable — до привязки к учителю
  createdAt DateTime @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  teacher     TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@index([teacherId])
}

model Homework {
  id          String    @id @default(cuid())
  teacherId   String
  title       String
  description String?
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teacher       TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  tasks         Task[]
  submissions   Submission[]

  @@index([teacherId])
}

model Task {
  id            String  @id @default(cuid())
  homeworkId    String
  order         Int // порядок задачи внутри ДЗ (1..N)
  content       String // текст задачи, может содержать LaTeX ($...$, $$...$$)
  correctAnswer String? // опционально — эталон для автопроверки
  requirePhoto  Boolean @default(false)

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([homeworkId, order])
}

model Submission {
  id          String    @id @default(cuid())
  studentId   String
  homeworkId  String
  status      String    @default("DRAFT") // 'DRAFT' | 'SUBMITTED' | 'CHECKED'
  submittedAt DateTime?
  grade       String? // итоговая оценка (число или строка — на усмотрение учителя)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  homework Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@unique([studentId, homeworkId])
  @@index([homeworkId])
}

model Answer {
  id           String   @id @default(cuid())
  submissionId String
  taskId       String
  textAnswer   String?
  photoUrl     String?
  isCorrect    Boolean? // результат автопроверки (null — не проверено / нет эталона)
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([submissionId, taskId])
  @@index([taskId])
}
